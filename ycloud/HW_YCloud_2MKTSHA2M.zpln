      "status": "FINISHED",
      "focus": true,
      "$$hashKey": "object:3670",
      "dateFinished": "2026-03-01T09:50:05+0000",
      "dateStarted": "2026-03-01T09:50:04+0000",
      "title": "Для каждого города выбрать Top-2 товара по revenue_sum используя Window"
    },
