      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1772357109344_1373307353",
      "id": "paragraph_1772357109344_1373307353",
      "dateCreated": "2026-03-01T09:25:09+0000",
      "status": "FINISHED",
      "focus": true,
      "$$hashKey": "object:3324",
      "dateFinished": "2026-03-01T09:35:13+0000",
      "dateStarted": "2026-03-01T09:35:12+0000",
      "title": "Объединить orders с users и products"
    },
    {
      "text": "%spark.pyspark\nmart_aggregated = (df_joined\n                   .groupBy(\"city\", \"product_id\", \"product_name\")\n                   .agg(\n                       F.count(\"order_id\").alias(\"orders_cnt\"),\n                       F.sum(\"qty\").alias(\"qty_sum\"),\n                       F.sum(\"revenue\").alias(\"revenue_sum\")\n                   )\n                   .orderBy(\"city\", F.desc(\"revenue_sum\")))\n\nmart_aggregated.show()",
      "user": "anonymous",
      "dateUpdated": "2026-03-01T09:38:37+0000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "scala",
          "editOnDblClick": false,
          "completionKey": "TAB",
          "completionSupport": true
        },
        "colWidth": 12,
        "editorMode": "ace/mode/scala",
        "fontSize": 9,
        "title": true,
        "results": {},
        "enabled": true
      },
      "settings": {
        "params": {},
        "forms": {}
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1772357259063_307944167",
      "id": "paragraph_1772357259063_307944167",
      "dateCreated": "2026-03-01T09:27:39+0000",
      "status": "FINISHED",
      "focus": true,
      "$$hashKey": "object:3589",
      "dateFinished": "2026-03-01T09:38:38+0000",
      "dateStarted": "2026-03-01T09:38:37+0000",
      "title": "Посчитать метрики по (city, product_id, product_name)"
    },
    {
      "text": "%spark.pyspark\nwindow_spec = Window.partitionBy(\"city\").orderBy(F.desc(\"revenue_sum\"))\nmart_with_rank = mart_aggregated.withColumn(\n    \"rank\", \n    F.row_number().over(window_spec)\n)\nmart_top = mart_with_rank.filter(F.col(\"rank\") <= 2)\nmart_top.select(\n    \"city\", \"product_id\", \"product_name\", \n    \"orders_cnt\", \"qty_sum\", \"revenue_sum\", \"rank\"\n).orderBy(\"city\", \"rank\").show()",
      "user": "anonymous",
      "dateUpdated": "2026-03-01T09:50:04+0000",
      "progress": 0,
      "config": {
        "editorSetting": {
          "language": "scala",
